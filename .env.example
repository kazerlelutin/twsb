# Premier administrateur, créé au démarrage si aucun compte n'existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL publique (liens des e-mails, sitemap, canonical).
PUBLIC_URL=http://localhost:3000

# Dossier persistant : site.sqlite + media/. En conteneur : /data.
DATA_DIR=./data

# SMTP (facultatif). Sans SMTP, les liens d'activation s'affichent dans l'admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mon site <no-reply@example.com>
