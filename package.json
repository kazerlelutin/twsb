{
  "name": "twsb",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host 0.0.0.0 --port 3000",
    "build": "bun --bun vite build && bun scripts/stamp-version.ts",
    "start": "bun launcher/launcher.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bddgen && playwright test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "release": "bun scripts/release.ts",
    "deploy:caprover": "bun scripts/caprover-tar.ts"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.0",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bubble-menu": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-youtube": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "fflate": "^0.8.3",
    "nitro": "3.0.260610-beta",
    "nodemailer": "^10.6.1",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "solid-js": "1.9.14",
    "vite": "^8.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@solidjs/testing-library": "^0.8.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "jsdom": "^26",
    "playwright-bdd": "^9.2.1",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^4",
    "vitest-axe": "^0.1.0"
  }
}
